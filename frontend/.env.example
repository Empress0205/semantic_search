# Copy to .env.local to change how the frontend gets its data.

# false (default) — notes live in browser storage and search uses an
#   approximate local similarity, so the UI runs with no backend.
# true — notes and search come from the FastAPI service (Phase 5).
VITE_USE_BACKEND=false

# Only needed when the backend is not reachable through the Vite dev proxy
# (which forwards /api to http://127.0.0.1:8000).
# VITE_API_BASE_URL=http://127.0.0.1:8000
