# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtual environment
env/
venv/
.venv/

# Environment variables
.env
.env.local

# Vector store / generated data
# Leading ** so the store is ignored wherever it sits: a pattern containing a
# slash is anchored to this file's directory, so a bare data/chroma/ would miss
# backend/data/chroma/.
**/data/chroma/
**/chroma_data/

# Node / frontend
node_modules/
dist/

