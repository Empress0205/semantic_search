# Copy to .env to override any of these. Every value has a working default,
# so .env is optional.

# --- Storage ---
# Where ChromaDB keeps its vectors, relative to the project root.
CHROMA_PATH=data/chroma
COLLECTION_NAME=notes

# --- Embeddings ---
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Distance metric for the collection. Fixed when the collection is first
# created — to change it, delete data/chroma and let it rebuild.
DISTANCE_METRIC=cosine

# --- Search ---
DEFAULT_N_RESULTS=5
MAX_N_RESULTS=50

# How many extra results to pull when a similarity threshold is set, so the
# filtered list still fills up to the requested size.
SEARCH_OVERFETCH=3

# Minimum score for a note to appear in "related notes". Raise it for a
# stricter panel, set it to 0 to always show the nearest neighbours.
RELATED_MIN_SCORE=0.35

# --- API ---
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
